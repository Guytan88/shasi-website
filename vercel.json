{
  "buildCommand": "python3 build.py",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/vin-check",
      "destination": "https://www.shasi.app/vin-check",
      "permanent": true
    },
    {
      "source": "/review",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*[Aa]ndroid.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.shasi.app&showAllReviews=true",
      "permanent": false
    },
    {
      "source": "/review",
      "destination": "https://apps.apple.com/app/id6799770868?action=write-review",
      "permanent": false
    }
  ]
}
